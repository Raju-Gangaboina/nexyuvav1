# Copy to .env and fill in real values. See app/core/config.py for how each
# is consumed and what degrades gracefully (Rules.md Section 3) if left unset.

# --- Required to boot ---
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
JWT_SECRET_KEY=generate-a-long-random-string

# --- Optional, degrade gracefully if unset ---
GITHUB_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Used by: app/ai/chatbot.py (RAG fallback) and app/ai/ats_analyzer.py
# (genuine-mistakes qualitative layer). Without this, both features still
# work in deterministic/FAQ-only mode -- get a free key at console.groq.com.
GROQ_API_KEY=

GEMINI_API_KEY=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Smart Scheduling (Module 5.5) — Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID (Web application). Redirect URI must match
# exactly what you register there, e.g.
# http://localhost:8000/api/v1/scheduling/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
