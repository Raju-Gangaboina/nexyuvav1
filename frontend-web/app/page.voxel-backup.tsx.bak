          </div>

          <div style={{ position:'relative', paddingBottom:20, display:'flex', justifyContent:'center' }}>
            <div style={{
              position:'relative', width:480, maxWidth:'100%', aspectRatio:'1/1',
              opacity: uiPhase >= 4 ? 1 : 0, transition:'opacity 0.5s ease',
            }}>
              {/* Blue circle + monument + tricolor wave, procedural (no raster asset) */}
              <IndiaHeroArt />

              {/* PM portrait, masked into the top of the circle so it blends into the art */}
              <div style={{
                position:'absolute', top:'6%', left:'50%', transform:'translateX(-50%)',
                width:'54%', height:'62%', overflow:'hidden',
                borderRadius:'50% 50% 42% 42% / 50% 50% 30% 30%',
                opacity: uiPhase >= 5 ? 1 : 0, transition:'opacity 0.7s ease',
                boxShadow:'0 12px 40px rgba(18,41,107,0.35)',
              }}>
                <Image src="/pm-hero.jpg" alt="PM Narendra Modi" fill priority
                  sizes="(max-width: 768px) 100vw, 300px"
                  style={{ objectFit:'cover', objectPosition:'center 22%' }} />
                <div style={{
                  position:'absolute', inset:0,
                  background:'linear-gradient(180deg, rgba(18,41,107,0) 60%, rgba(18,41,107,0.55) 100%)',
                }} />
              </div>

              {/* Floating feature badge card, bottom of the art — mirrors the target layout */}
              <div style={{
                position:'absolute', left:'6%', right:'6%', bottom:'2%',
                background:'#fff', border:`1px solid ${C.border}`, borderRadius:14,
                padding:'18px 20px', display:'grid', gridTemplateColumns:'repeat(2,1fr)', gap:'14px 18px',
                boxShadow:'0 16px 40px rgba(18,41,107,0.16), 0 2px 6px rgba(0,0,0,0.06)',
                opacity: uiPhase >= 6 ? 1 : 0, transform: uiPhase >= 6 ? 'translateY(0)' : 'translateY(10px)',
                transition:'opacity 0.5s ease, transform 0.5s ease',
              }}>
                {[
                  { icon:'🎯', label:'AI Matching', sub:'Smart recommendations', color:C.blue },
                  { icon:'📈', label:'Skill Gap Analysis', sub:'Identify & improve', color:C.orange },
                  { icon:'💬', label:'AI Career Guide', sub:'Your personal mentor', color:C.blue },
                  { icon:'✅', label:'Govt. Approved', sub:'Secure & official', color:'#2D7A5F' },
                ].map(b => (
                  <div key={b.label} style={{ display:'flex', alignItems:'flex-start', gap:8 }}>
                    <span style={{ fontSize:16, lineHeight:1, flexShrink:0 }}>{b.icon}</span>
                    <div style={{ minWidth:0 }}>
                      <div style={{ fontFamily:SANS, fontSize:12, fontWeight:700, color:'#111', lineHeight:1.3 }}>{b.label}</div>
                      <div style={{ fontFamily:SANS, fontSize:10.5, color:'#666', lineHeight:1.3 }}>{b.sub}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* STATISTICS */}
      <section style={{ position:'relative', zIndex:1, padding:'0 48px 120px', ...xStyle(6) }}>
        <div style={{ maxWidth:1100, margin:'0 auto' }}>
          <div style={{ display:'flex', alignItems:'center', justifyContent:'space-between', marginBottom:20, opacity:0.6 }}>
            <span style={{ fontFamily:MONO, fontSize:9, color:C.muted, letterSpacing:'0.12em', textTransform:'uppercase' }}>// SYS.02_METRICS</span>
            <div style={{ display:'flex', alignItems:'center', gap:6 }}>
              <PxRuler length={40} color="rgba(43,127,212,0.15)" />
              <VxDot size={3} color={C.blue} />
            </div>
          </div>

          <div style={{ display:'grid', gridTemplateColumns:'repeat(4,1fr)', gap:16 }}>
          {[
            {target:10, suffix:'L+',  label:'Students Onboarded'},
            {target:15, suffix:'K+',  label:'Internships Available'},
            {target:500,suffix:'+',   label:'Partner Companies'},
            {target:100,suffix:'%',   label:'Government Approved'},
          ].map((s,i)=>(
            <div key={s.label} style={{
              position:'relative', background:C.panel,
              border:`1px solid ${C.border}`, padding:'36px 24px', textAlign:'center',
              boxShadow:`1px 1px 0 ${C.blueDeep},2px 2px 0 ${C.blueMid},3px 3px 0 rgba(0,0,0,0.26),4px 4px 0 rgba(0,0,0,0.13)`,
              animation: alive ? `breathe ${7+i}s cubic-bezier(0.37,0,0.63,1) ${i*0.6}s infinite` : 'none',
            }}>
              <VoxelCorner pos="tl" size={12} color={C.blueAccent} depth={1} />
              <VoxelCorner pos="br" size={8}  color="rgba(232,230,225,0.06)" depth={1} />
              <div style={{ fontFamily:SERIF, fontSize:28, fontWeight:600, color:C.white, lineHeight:1.2, marginBottom:10 }}>
                <CountUp target={s.target} suffix={s.suffix} />
              </div>
              <div style={{ fontFamily:MONO, fontSize:9, color:C.muted, letterSpacing:'0.08em', textTransform:'uppercase', marginBottom:12 }}>{s.label}</div>
              <div style={{ width:20, height:2, background:C.blueAccent, margin:'0 auto', boxShadow:`1px 1px 0 ${C.blueDeep}` }} />
            </div>
          ))}
          </div>
        </div>
      </section>

      {/* FEATURES */}
      <section id="features" style={{ position:'relative', zIndex:1, padding:'0 48px 140px' }}>
        <div style={{ maxWidth:1100, margin:'0 auto' }}>
          <div style={{ display:'flex', alignItems:'center', justifyContent:'space-between', marginBottom:32, opacity:0.5 }}>
            <span style={{ fontFamily:MONO, fontSize:9, color:C.muted, letterSpacing:'0.12em', textTransform:'uppercase' }}>// SYS.03_CAPABILITIES</span>
            <PxRuler length={120} color="rgba(43,127,212,0.15)" />
          </div>

          <FadeUp>
            <div style={{ marginBottom:72 }}>
              <div style={{ display:'flex', alignItems:'center', gap:10, marginBottom:24 }}>
                <PxRuler length={28} color={C.blueAccent} />
                <span style={{ fontFamily:MONO, fontSize:10, fontWeight:500, color:C.blue, letterSpacing:'0.08em',
                  textTransform:'uppercase', padding:'4px 14px', border:`1px solid rgba(43,127,212,0.12)`,
                  background:'rgba(43,127,212,0.02)', boxShadow:`1px 1px 0 ${C.blueDeep},2px 2px 0 rgba(0,0,0,0.20)` }}>Platform Modules</span>
              </div>
              <h2 style={{ fontFamily:SERIF, fontSize:52, fontWeight:600, color:C.white, lineHeight:1.08, marginBottom:16 }}>
                Intelligent matching,<br /><em style={{ color:C.blue, fontStyle:'italic' }}>finally</em> done right.
              </h2>
              <p style={{ fontSize:15, color:C.muted, fontFamily:SANS, maxWidth:400, lineHeight:1.8 }}>Every recommendation is explainable. Every match is meaningful.</p>
            </div>
          </FadeUp>

          <div style={{ display:'grid', gridTemplateColumns:'repeat(3,1fr)', gap:18 }}>
            {[
              {icon:ICONS.brain,   title:'AI Skill Matching',  desc:'ML engine analyzing 40+ signals — skills, location, domain, academic background — for the most relevant internships.', delay:0,   accent:C.blueAccent},
              {icon:ICONS.target,  title:'Explainable AI',     desc:'Every match includes a clear reason. Students see exactly which skills helped them qualify and what they need to grow.', delay:80,  accent:C.orangeAccent},
              {icon:ICONS.chart,   title:'Skill Gap Analysis', desc:'Personalized learning roadmap updated in real time as your profile evolves, guided by live industry demand signals.', delay:160, accent:"rgba(232,230,225,0.10)"},
              {icon:ICONS.diamond, title:'Career AI Guide',    desc:'Ask anything — from resume tips to interview prep. Our RAG-powered AI gives contextual guidance for your target role.', delay:0,   accent:C.blueAccent},
              {icon:ICONS.shield,  title:'Ministry Dashboard', desc:'Real-time national analytics — state-wise placements, Tier-2/3 equity metrics, scheme ROI at a glance.', delay:80,  accent:C.orangeAccent},
              {icon:ICONS.grid,    title:'Company Portal',     desc:'AI-ranked candidates, smart filtering, one-click shortlisting. Find the right intern in minutes, not days.', delay:160, accent:"rgba(232,230,225,0.10)"},
            ].map(f=>{
              const ic = f.accent.includes('43,127,212')?C.blue:f.accent.includes('43,127,212')?C.orange:C.white;
              return (
                <VxCard key={f.title} delay={f.delay} accentColor={f.accent}>
                  <div style={{ padding:'40px 32px' }}>
                    <div style={{ width:48, height:48, border:`1px solid ${f.accent}`, background:f.accent.replace(/[\d.]+\)$/,'0.05)'),
                      display:'flex', alignItems:'center', justifyContent:'center', marginBottom:24,
                      boxShadow:`1px 1px 0 ${C.blueDeep},2px 2px 0 rgba(0,0,0,0.28)` }}>
                      <VxIcon pattern={f.icon} color={ic} size={3} />
                    </div>
                    <h3 style={{ fontFamily:SERIF, fontSize:22, fontWeight:600, color:C.white, marginBottom:12, lineHeight:1.25 }}>{f.title}</h3>
                    <p style={{ fontSize:14, color:C.muted, lineHeight:1.8, fontFamily:SANS }}>{f.desc}</p>
                    <div style={{ marginTop:24 }}><PxRuler length={36} color={f.accent} /></div>
                  </div>
                </VxCard>
              );
            })}
          </div>
        </div>
      </section>

      {/* HOW IT WORKS */}
      <section id="how-it-works" style={{ position:'relative', zIndex:1, padding:'0 48px 140px' }}>
        <div style={{ maxWidth:900, margin:'0 auto' }}>
          <div style={{ display:'flex', alignItems:'center', justifyContent:'space-between', marginBottom:32, opacity:0.5 }}>
            <span style={{ fontFamily:MONO, fontSize:9, color:C.muted, letterSpacing:'0.12em', textTransform:'uppercase' }}>// SYS.04_WORKFLOW</span>
            <PxRuler length={100} color="rgba(43,127,212,0.15)" />
          </div>

          <FadeUp>
            <div style={{ textAlign:'center', marginBottom:72 }}>
              <h2 style={{ fontFamily:SERIF, fontSize:52, fontWeight:600, color:C.white, marginBottom:20 }}>
                Three steps to your<br /><em style={{ color:C.blue, fontStyle:'italic' }}>perfect internship</em>.
              </h2>
              <div style={{ display:'flex', justifyContent:'center' }}><PxRuler length={60} color={C.blueAccent} /></div>
            </div>
          </FadeUp>

          <div style={{ display:'grid', gridTemplateColumns:'repeat(3,1fr)', gap:18 }}>
            {[
              {step:'01', title:'Build Your Profile', desc:'Enter skills, education, domain preference and location. The AI creates your opportunity fingerprint.', color:C.blue},
              {step:'02', title:'Get AI Matches',     desc:'NexYuva ranks thousands of internships and shows your top matches with scores, explained in plain language.', color:C.orange},
              {step:'03', title:'Apply & Grow',       desc:'Apply in one click, track your pipeline, and follow your personalised skill roadmap to land the role.', color:C.white},
            ].map((s,i)=>(
              <FadeUp key={s.step} delay={i*100}>
                <div style={{ position:'relative', background:C.panel, border:`1px solid ${C.border}`,
                  borderTop:`2px solid ${s.color}20`, padding:'40px 28px',
                  boxShadow:`1px 1px 0 ${C.blueDeep},2px 2px 0 ${C.blueMid},3px 3px 0 rgba(0,0,0,0.24)` }}>
                  <VoxelCorner pos="tl" color={`${s.color}28`} size={14} depth={1} />
                  <VoxelCorner pos="br" color={`${s.color}14`} size={10} depth={1} />
                  <div style={{ fontFamily:SERIF, fontSize:56, fontWeight:300, color:`${s.color}08`, lineHeight:1, marginBottom:20, userSelect:'none' }}>{s.step}</div>
                  <div style={{ width:8, height:8, background:s.color, marginBottom:16, boxShadow:'1px 1px 0 rgba(0,0,0,0.50),2px 2px 0 rgba(0,0,0,0.28)' }} />
                  <h3 style={{ fontFamily:SERIF, fontSize:22, fontWeight:600, color:C.white, marginBottom:12 }}>{s.title}</h3>
                  <p style={{ fontSize:14, color:C.muted, lineHeight:1.8, fontFamily:SANS }}>{s.desc}</p>
                </div>
              </FadeUp>
            ))}
          </div>
        </div>
      </section>

      {/* TESTIMONIALS */}
      <section style={{ position:'relative', zIndex:1, padding:'0 48px 140px' }}>
        <div style={{ maxWidth:1100, margin:'0 auto' }}>
          <div style={{ display:'flex', alignItems:'center', justifyContent:'space-between', marginBottom:32, opacity:0.5 }}>
            <span style={{ fontFamily:MONO, fontSize:9, color:C.muted, letterSpacing:'0.12em', textTransform:'uppercase' }}>// SYS.05_TESTIMONIALS</span>
            <PxRuler length={100} color="rgba(43,127,212,0.15)" />
          </div>

          <FadeUp>
            <div style={{ textAlign:'center', marginBottom:72 }}>
              <h2 style={{ fontFamily:SERIF, fontSize:52, fontWeight:600, color:C.white, marginBottom:16 }}>
                What India&rsquo;s youth<br /><em style={{ color:C.blue, fontStyle:'italic' }}>is saying</em>.
              </h2>
              <div style={{ display:'flex', justifyContent:'center' }}><PxRuler length={60} color="rgba(43,127,212,0.14)" /></div>
            </div>
          </FadeUp>
          <div style={{ display:'grid', gridTemplateColumns:'repeat(3,1fr)', gap:18 }}>
            {[
              {q:'Build a complete profile with your skills, location preference, and work mode to get matched instantly.',name:'Student Onboarding', role:'Register & Apply',init:'S',delay:0},
              {q:'Companies post real opportunities with exact stipend, duration, and skill requirements for top talent.',name:'Employer Posting',  role:'Hire Interns',      init:'E',delay:100},
              {q:'Real-time transparent recommendations with skill gap analysis to prepare you for your dream role.',name:'AI Match Engine',  role:'Smart Evaluation', init:'A',delay:200},
            ].map(t=>(
              <FadeUp key={t.name} delay={t.delay}>
                <div style={{ position:'relative', background:C.panel, border:`1px solid ${C.border}`, padding:'36px 28px', height:'100%',
                  boxShadow:`1px 1px 0 ${C.blueDeep},2px 2px 0 ${C.blueMid},3px 3px 0 rgba(0,0,0,0.24)` }}>
                  <VoxelCorner pos="tl" color={C.blueAccent} size={14} depth={1} />
                  <VoxelCorner pos="br" color={C.blueAccent} size={10} depth={1} />
                  <div style={{ fontFamily:SERIF, fontSize:60, fontWeight:300, color:'rgba(43,127,212,0.06)', lineHeight:0.7, marginBottom:16, userSelect:'none' }}>&ldquo;</div>
                  <p style={{ fontFamily:SERIF, fontSize:17, fontStyle:'italic', color:C.white, lineHeight:1.8, marginBottom:24 }}>{t.q}</p>
                  <div style={{ display:'flex', alignItems:'center', gap:12 }}>
                    <div style={{ width:36, height:36, background:C.blueDim, border:`1px solid ${C.blueAccent}`,
                      display:'flex', alignItems:'center', justifyContent:'center', color:C.blue, fontWeight:600,
                      fontSize:14, fontFamily:SERIF, boxShadow:`1px 1px 0 ${C.blueDeep},2px 2px 0 rgba(0,0,0,0.28)` }}>{t.init}</div>
                    <div>
                      <div style={{ fontWeight:600, fontSize:13, color:C.white }}>{t.name}</div>
                      <div style={{ fontSize:11, color:C.muted, marginTop:2, fontFamily:MONO }}>{t.role}</div>
                    </div>
                  </div>
                </div>
              </FadeUp>
            ))}
          </div>
        </div>
      </section>

      {/* FOR COMPANIES */}
      <section id="for-companies" style={{ position:'relative', zIndex:1, padding:'0 48px 140px' }}>
        <div style={{ maxWidth:1100, margin:'0 auto' }}>
          <div style={{ display:'flex', alignItems:'center', justifyContent:'space-between', marginBottom:32, opacity:0.5 }}>
            <span style={{ fontFamily:MONO, fontSize:9, color:C.muted, letterSpacing:'0.12em', textTransform:'uppercase' }}>// SYS.06_ENTERPRISE</span>
            <PxRuler length={100} color="rgba(43,127,212,0.15)" />
          </div>

          <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:100, alignItems:'center' }}>
          <FadeUp>
            <div>
              <div style={{ display:'flex', alignItems:'center', gap:10, marginBottom:28 }}>
                <PxRuler length={20} color={C.blueAccent} />
                <span style={{ fontFamily:MONO, fontSize:10, fontWeight:500, color:C.blue, letterSpacing:'0.08em',
                  textTransform:'uppercase', padding:'4px 14px', border:`1px solid rgba(43,127,212,0.15)`,
                  background:'rgba(43,127,212,0.02)', boxShadow:`1px 1px 0 ${C.blueDeep},2px 2px 0 rgba(0,0,0,0.18)` }}>Employer Platform</span>
              </div>
              <h2 style={{ fontFamily:SERIF, fontSize:48, fontWeight:600, color:C.white, lineHeight:1.08, marginBottom:24 }}>
                Find the right intern.<br />Not just <em style={{ color:C.blue, fontStyle:'italic' }}>any</em> intern.
              </h2>
              <div style={{ marginBottom:28 }}><PxRuler length={60} color="rgba(43,127,212,0.16)" /></div>
              <p style={{ fontSize:15, color:C.muted, lineHeight:1.85, marginBottom:40, maxWidth:420, fontFamily:SANS }}>
                Post opportunities and receive AI-ranked candidates scored specifically against your requirements. Cut sourcing time by 80%.
              </p>
              <Link href="/company/dashboard" className="vx-btn-blue" style={{
                padding:'13px 28px', background:C.blue, color:C.bg,
                fontFamily:MONO, fontSize:11, fontWeight:700, textDecoration:'none',
                border:`1px solid ${C.blue}`, letterSpacing:'0.03em', textTransform:'uppercase',
                display:'inline-flex', alignItems:'center', gap:8,
              }}>Access Company Portal →</Link>
