      {/* FOOTER */}
      <footer style={{ position:'relative', zIndex:1, padding:'0 48px 60px' }}>
        <div style={{ maxWidth:1100, margin:'0 auto' }}>
          <div style={{ position:'relative', background:C.panel, border:`1px solid ${C.border}`,
            boxShadow:`1px 1px 0 ${C.blueDeep},2px 2px 0 ${C.blueMid},3px 3px 0 rgba(0,0,0,0.24),4px 4px 0 rgba(0,0,0,0.12)`,
            padding:'52px 44px' }}>
            <VoxelCorner pos="tl" size={14} color={C.blueAccent}   depth={2} />
            <VoxelCorner pos="br" size={14} color={C.orangeAccent} depth={2} />

            <div className="footer-grid" style={{ display:'grid', gridTemplateColumns:'minmax(220px,2fr) repeat(3, minmax(140px,1fr))', gap:40, marginBottom:44 }}>
              <div style={{ minWidth:0 }}>
                <Link href="/" className="flex items-center gap-3" style={{ display:'inline-flex', alignItems:'center', gap:14, textDecoration:'none', marginBottom:18 }}>
                  <Image src="/nexyuva-light-logo.png" alt="NexYuva" width={170} height={44}
                    className="logo-dark-only h-11 w-auto object-contain shrink-0"
                    style={{ height:44, width:'auto', objectFit:'contain', flexShrink:0, }} priority />
                  <Image src="/nexyuva-light-logo.png" alt="NexYuva" width={170} height={44}
                    className="logo-light-only h-11 w-auto object-contain shrink-0"
                    style={{ height:44, width:'auto', objectFit:'contain', flexShrink:0 }} priority />
                </Link>
                <p style={{ fontSize:13, color:C.mutedSoft, lineHeight:1.75, maxWidth:260, marginBottom:0, fontFamily:SANS }}>
                  India&rsquo;s AI-powered internship platform under the PM Internship Scheme.
                </p>
                <div style={{ display:'flex', gap:4, marginTop:18 }}>
                  {[C.blue,C.blueDeep,C.orange,C.white,C.charcoal].map((c,i)=>(
                    <div key={i} style={{ width:5, height:5, background:c, boxShadow:'1px 1px 0 rgba(0,0,0,0.50)' }} />
                  ))}
                </div>
              </div>
              {[
                {heading:'Platform',links:['For Students','For Companies','AI Features','Skill Analysis']},
                {heading:'Ministry',links:['About the Scheme','Analytics','State Reports','Contact']},
                {heading:'Legal',   links:['Privacy Policy','Terms of Service','Data Security','Grievance']},
              ].map(col=>(
                <div key={col.heading}>
                  <h4 style={{ fontFamily:MONO, fontSize:9, fontWeight:600, letterSpacing:'0.10em', textTransform:'uppercase',
                    color:C.muted, marginBottom:16, paddingBottom:8, borderBottom:`1px solid ${C.border}` }}>{col.heading}</h4>
                  {col.links.map(l=>(
                    <a key={l} href="#" style={{ display:'block', fontSize:13, color:C.mutedSoft, marginBottom:8,
                      textDecoration:'none', transition:'color 0.15s', fontFamily:SANS }}>{l}</a>
                  ))}
                </div>
              ))}
            </div>
            <div style={{ borderTop:`1px solid ${C.border}`, paddingTop:20, display:'flex', justifyContent:'space-between', alignItems:'center', flexWrap:'wrap', gap:8 }}>
              <p style={{ fontFamily:MONO, fontSize:10, color:C.mutedSoft }}>
                © 2025 NexYuva · Ministry of Labour & Employment, Government of India
              </p>
              <div style={{ display:'flex', gap:5, alignItems:'center' }}>
                <VxDot size={3} color="rgba(43,127,212,0.20)" />
                <VxDot size={3} color="rgba(43,127,212,0.20)" />
                <VxDot size={3} color="rgba(232,230,225,0.07)" />
              </div>
            </div>
          </div>
        </div>
      </footer>

    </div>
  );
}
