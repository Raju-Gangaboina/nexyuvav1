          </FadeUp>

          <FadeUp delay={150}>
            <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:14 }}>
              {[
                {label:'Instant Ranking',val:'AI Engine', color:C.blue},
                {label:'Smart Sourcing',val:'Filters',  color:C.blue},
                {label:'Direct Hiring',  val:'No Agency',color:C.blue},
                {label:'Official Scheme',val:'Compliant',color:C.blue},
              ].map(m=>(
                <div key={m.label} style={{ position:'relative', background:C.panel,
                  border:`1px solid ${C.border}`, borderTop:`2px solid ${m.color}22`, padding:'28px 20px',
                  boxShadow:`1px 1px 0 ${C.blueDeep},2px 2px 0 ${C.blueMid},3px 3px 0 rgba(0,0,0,0.20)` }}>
                  <VoxelCorner pos="tl" color={`${m.color}22`} size={10} depth={1} />
                  <div style={{ fontFamily:SERIF, fontSize:22, fontWeight:700, color:m.color, lineHeight:1.2, marginBottom:8, textShadow:'1px 1px 0 rgba(0,0,0,0.40)' }}>{m.val}</div>
                  <div style={{ fontFamily:MONO, fontSize:9, color:C.muted, letterSpacing:'0.06em', textTransform:'uppercase' }}>{m.label}</div>
                </div>
              ))}
            </div>
          </FadeUp>
          </div>
        </div>
      </section>

      {/* MINISTRY MODULE */}
      <section id="ministry" style={{ position:'relative', zIndex:1, padding:'0 48px 140px' }}>
        <div style={{ maxWidth:880, margin:'0 auto', textAlign:'center' }}>
          <FadeUp>
            <div style={{ position:'relative', background:C.panel, border:`1px solid rgba(43,127,212,0.07)`,
              boxShadow:`1px 1px 0 ${C.blueDeep},2px 2px 0 ${C.blueMid},3px 3px 0 ${C.blueDark},4px 4px 0 #0a1e38,5px 5px 0 rgba(0,0,0,0.28),6px 6px 0 rgba(0,0,0,0.14),7px 7px 0 rgba(0,0,0,0.07)`,
              padding:'88px 64px', overflow:'hidden' }}>
              <Image src="/black-mode.png" alt="" fill className="hero-bg-dark-only" style={{ objectFit:'cover', zIndex:0, pointerEvents:'none' }} />
              <Image src="/white-mode.png" alt="" fill className="hero-bg-light-only" style={{ objectFit:'cover', zIndex:0, pointerEvents:'none' }} />

              <div style={{ position:'relative', zIndex:1 }}>
              <VoxelCorner pos="tl" size={22} color={C.blueAccent}   depth={3} />
              <VoxelCorner pos="tr" size={16} color={C.blueAccent}   depth={2} />
              <VoxelCorner pos="bl" size={16} color={C.orangeAccent} depth={2} />
              <VoxelCorner pos="br" size={22} color={C.orangeAccent} depth={3} />

              <div style={{ display:'flex', justifyContent:'center', gap:8, marginBottom:40 }}>
                {[C.blue,C.orange,C.white,C.orange,C.blue].map((c,i)=>(
                  <div key={i} style={{ width:5, height:5, background:c, opacity:0.30, boxShadow:'1px 1px 0 rgba(0,0,0,0.50)' }} />
                ))}
              </div>

              <h2 style={{ fontFamily:SERIF, fontSize:52, fontWeight:600, color:C.white, lineHeight:1.08, marginBottom:24 }}>
                Backed by India&rsquo;s<br /><em style={{ color:C.orange, fontStyle:'italic' }}>PM Internship Scheme</em>.
              </h2>
              <p style={{ fontSize:15, color:C.muted, lineHeight:1.85, maxWidth:460, margin:'0 auto 52px', fontFamily:SANS }}>
                A national initiative under the Ministry of Labour & Employment, empowering one crore youth through structured internships with India&rsquo;s top companies.
              </p>

              <div style={{ display:'flex', justifyContent:'center', gap:16, flexWrap:'wrap' }}>
                <Link href="/register" className="vx-btn-blue" style={{
                  padding:'13px 28px', background:C.white, color:C.bg,
                  fontFamily:MONO, fontSize:11, fontWeight:700, textDecoration:'none',
                  border:`1px solid ${C.white}`, letterSpacing:'0.03em', textTransform:'uppercase',
                }}>Apply as Student</Link>
                <Link href="/admin/dashboard" style={{
                  padding:'13px 28px', background:'transparent', color:C.muted,
                  fontFamily:MONO, fontSize:11, fontWeight:500, textDecoration:'none',
                  textTransform:'uppercase', border:`1px solid ${C.borderHover}`,
                  boxShadow:`1px 1px 0 ${C.blueDeep},2px 2px 0 ${C.blueMid},3px 3px 0 rgba(0,0,0,0.16)`,
                  transition:'all 0.15s', letterSpacing:'0.03em',
                }}>Ministry Dashboard →</Link>
              </div>
